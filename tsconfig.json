{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.js",
    "config/**/*.js",
    "public/js/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
