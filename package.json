{
  "name": "vuelos-martin",
  "version": "1.0.0",
  "description": "Cazador Inteligente de Vuelos Chollo desde BCN",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "scan": "node --env-file=.env src/index.js --once",
    "test-alert": "node --env-file=.env src/test-alert.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "flights",
    "deals",
    "ryanair",
    "telegram",
    "travel"
  ],
  "author": "Martín",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.19"
  }
}
